{
  "name": "project-sikap",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "dev": "node scripts/prepare-app.mjs && vite",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write app src scripts tests supabase/functions package.json tsconfig.json vite.config.ts",
    "format:check": "prettier --check app src scripts tests supabase/functions package.json tsconfig.json vite.config.ts",
    "check": "npm run build && npm test && npm run format:check",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@supabase/supabase-js": "^2.0.0",
    "@zip.js/zip.js": "^2.24.0",
    "libphonenumber-js": "^1.13.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
